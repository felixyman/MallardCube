      "id": "Andel signerade DVT Under två timmar",
      "fact_table": "default",
      "malloy_name": "andel_signerade_dvt_under_två_timmar",
      "physical_expr": "antal_signerade_dvt_remisser { where: beställning_till_signering <= '0.083333' } / antal_signerade_dvt_remisser",
