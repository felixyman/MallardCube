source: dw_fys_f_undersökning is duckdb.table('dw_fys_f_undersökning') extend {
  join_one: dw_fys_kalender_remissdatum with remissdatum
  join_one: dw_fys_kalender_signeringsdatum with signeringsdatum
  join_one: dw_fys_kalender_undersökningsstart with undersökningsstart
  join_one: dw_fys_kalender_undersökningsslut with undersökningsslut
  join_one: dw_fys_kalender_beställningsdatum with beställningsdatum
  join_one: dw_fys_d_utförare with utförareid
  join_one: dw_fys_d_patient with patientid
  join_one: dw_fys_d_beställare with beställareid
  join_one: dw_fys_d_remisstatus with remisstatusid
  join_one: dw_fys_d_produkt with produktid
  join_one: dw_fys_kalender_bokningsdatum with bokningsdatum
  join_one: dw_fys_d_signerare with signerareid
  join_one: dw_fys_d_remissgrupp with remissgruppid
  join_one: dw_fys_d_remisskoder with remisskoderid
  join_one: dw_fys_kalender_måldatum with måldatum_från
  join_one: dw_fys_d_fakturamottagare with fakturamottagareid

  measure: andel_signerade_dvt_under_två_timmar is antal_signerade_dvt_remisser { where: beställning_till_signering <= '0.083333' } / antal_signerade_dvt_remisser  -- Andel signerade DVT Under två timmar
  measure: andel_under_fyra_timmar is antal_remisser_akuta_inneliggande_(under_fyra_timmar) / antal_remisser_akuta_inneliggande  -- Andel under fyra timmar
  measure: antal_bokade_remisser is antal_remisser { where: remisstatus = 'TID' }  -- Antal bokade remisser
  measure: antal_obokade_remisser is antal_remisser { where: remisstatus = 'EJ TID' }  -- Antal obokade remisser
  measure: antal_osignerade_utförda_undersökningar is antal_undersökningar { where: signeringsstatus = 'OSIGNERAD' }  -- Antal osignerade utförda undersökningar
  measure: antal_patienter is patientid.count(distinct true)  -- Antal patienter
  measure: antal_remisser is remissnummer.count(distinct true)  -- Antal remisser
  measure: antal_remisser_akuta_inneliggande is remissnummer.count(distinct true) { where: flagga_akuten = '1' }  -- Antal remisser akuta inneliggande
  measure: antal_remisser_akuta_inneliggande_(under_fyra_timmar) is antal_remisser_akuta_inneliggande { where: undersökningsslut_till_signering <= '0.1666667' }  -- Antal remisser akuta inneliggande (Under fyra timmar)
  measure: antal_remisser_i_urval is antal_remisser { where: akut = 'JA' }  -- Antal remisser i urval
  measure: antal_remisser_som_väntat_%3e30_dagar is antal_obokade_remisser { where: remiss_till_idag > '30' }  -- Antal remisser som väntat %3e30 dagar
  measure: antal_remisser_som_väntat_%3e60_dagar is antal_obokade_remisser { where: remiss_till_idag > '60' }  -- Antal remisser som väntat %3e60 dagar
  measure: antal_remisser_som_väntat_%3e90_dagar is antal_obokade_remisser { where: remiss_till_idag > '90' }  -- Antal remisser som väntat %3e90 dagar
  measure: antal_remissiser_med_tid_inom_4_veckor is antal_undersökningar { where: remiss_till_bokning <= '28' }  -- Antal remissiser med tid inom 4 veckor
  measure: antal_saknade_remisser_i_underlag is antal_remisser { where: akut = 'JA' }  -- Antal saknade remisser i underlag
  measure: antal_undersökningar is undersökningid.count()  -- Antal undersökningar
  measure: antal_uteblivna_remisser is antal_remisser { where: utebliven = 'JA' }  -- Antal uteblivna remisser
  measure: antal_utförda_remisser is antal_remisser { where: undersökningsstatus = 'UTFÖRD' }  -- Antal utförda remisser
  measure: medeltid_registrering_till_signering is registrering_till_signering.avg()  -- Medeltid registrering till signering
  measure: medeltid_undersökningsslut_till_signering is undersökningsslut_till_signering.avg()  -- Medeltid undersökningsslut till signering
  measure: referens_dvt_remiss is 0.8  -- Referens DVT remiss
  measure: tid_inom_4_veckor_från_skickad_remiss is antal_undersökningar { where: remiss_till_bokning <= '28' }  -- Tid inom 4 veckor från skickad remiss
}

