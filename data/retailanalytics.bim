      {
        "name": "DAX",
        "lineageTag": "3d54d45c-7c93-4486-ad2f-41160a76e53f",
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "= CALCULATE(SUM('Sales'[Net Sales (Revenue)]), 'Sales'[Is Return] = 0)",
            "formatString": "$ #,##0.00"
          },
          {
            "name": "Total COGS",
            "expression": "= SUMX(FILTER('Sales', 'Sales'[Is Return] = 0), 'Sales'[Sales Quantity] * RELATED('Products'[Unit Cost]))",
            "formatString": "$ #,##0.00"
          },
          {
            "name": "Gross Profit",
            "expression": "= [Total Revenue] - [Total COGS]",
            "formatString": "$ #,##0.00"
          },
          {
            "name": "Gross Margin %",
            "expression": "= DIVIDE([Gross Profit], [Total Revenue], 0)",
            "formatString": "#,##0.00 %"
          }
        ],
        "partitions": [
          {
