      "fact_table": "default",
      "sql_expr": "null",
      "caption": "Total COGS",
      "display_name": "Total COGS",
      "description": "[sql_fallback]  = SUMX ( FILTER ( 'Sales', 'Sales'[Is Return] = 0 ), 'Sales'[Sales Quantity] * RELATED ( 'Products'[Unit Cost] ) ) // Cost of Goods Sold (COGS) for non-return transactions",
