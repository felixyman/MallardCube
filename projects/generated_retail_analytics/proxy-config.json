      "sql_expr": "null",
      "caption": "Total Revenue",
      "display_name": "Total Revenue",
      "description": "[sql_fallback]  = CALCULATE ( SUM ( 'Sales'[Net Sales (Revenue)] ), 'Sales'[Is Return] = 0 ) // Total revenue excluding returns",
